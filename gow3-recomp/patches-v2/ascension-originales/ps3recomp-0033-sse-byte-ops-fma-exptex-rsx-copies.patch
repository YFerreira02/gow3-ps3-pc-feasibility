diff --git a/runtime/spu/tests/test_spu_qby_sse.c b/runtime/spu/tests/test_spu_qby_sse.c
new file mode 100644
index 0000000..d9e4794
--- /dev/null
+++ b/runtime/spu/tests/test_spu_qby_sse.c
@@ -0,0 +1,63 @@
+/* The SSE4.1 quadword byte rotates/shifts and shufb must match their _ref
+ * byte loops for every shift count and selector. Build on x86-64:
+ *   clang-cl -O2 -msse4.1 -I.. -I../.. -I../../.. test_spu_qby_sse.c
+ * and run with no arguments. */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+
+static uint64_t s_rng = 0x2545F4914F6CDD1Dull;
+static uint32_t rnd32(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 16);
+}
+static u128 rnd128(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rnd32(); return r; }
+
+static long s_bad;
+static void check(const char* op, u128 got, u128 ref, uint32_t arg)
+{
+    if (memcmp(&got, &ref, 16) == 0) return;
+    if (s_bad++ < 10)
+        printf("%s(arg 0x%08X): got %08X %08X %08X %08X want %08X %08X %08X %08X\n", op, arg,
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3], ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+}
+
+int main(void)
+{
+#if !defined(__SSE4_1__)
+    puts("test_spu_qby_sse: no SSE4.1, nothing to compare");
+    return 0;
+#else
+    long n = 0;
+    for (int it = 0; it < 20000; it++) {
+        const u128 a = rnd128();
+        /* every shift count in the low bits, random upper bits (ignored or not) */
+        for (uint32_t k = 0; k < 64; k++) {
+            u128 b = rnd128();
+            b._u32[0] = (it & 1) ? k : (rnd32() & ~0x3FFu) | k;
+            u128 b8 = b; b8._u32[0] = (b._u32[0] & ~0x1FFu) | (k << 3) | (rnd32() & 7);
+            check("shlqby",    spu_shlqby(a, b),    spu_shlqby_ref(a, b),    b._u32[0]);
+            check("rotqby",    spu_rotqby(a, b),    spu_rotqby_ref(a, b),    b._u32[0]);
+            check("rotqmby",   spu_rotqmby(a, b),   spu_rotqmby_ref(a, b),   b._u32[0]);
+            check("shlqbybi",  spu_shlqbybi(a, b8), spu_shlqbybi_ref(a, b8), b8._u32[0]);
+            check("rotqbybi",  spu_rotqbybi(a, b8), spu_rotqbybi_ref(a, b8), b8._u32[0]);
+            check("rotqmbybi", spu_rotqmbybi(a, b8), spu_rotqmbybi_ref(a, b8), b8._u32[0]);
+            check("rotqmbyi",  spu_rotqmbyi(a, (int)k - 32), spu_rotqmbyi_ref(a, (int)k - 32), k);
+            check("rotqmbyi",  spu_rotqmbyi(a, (int)k),      spu_rotqmbyi_ref(a, (int)k), k);
+            n += 8;
+        }
+        /* shufb: random selectors, ordinary ones (< 0x80) and all-special mixes */
+        for (int j = 0; j < 8; j++) {
+            const u128 b = rnd128();
+            u128 c = rnd128();
+            if (j < 4) for (int q = 0; q < 4; q++) c._u32[q] &= 0x1F1F1F1Fu;
+            check("shufb", spu_shufb(a, b, c), spu_shufb_ref(a, b, c), c._u32[0]);
+            check("cntb", spu_cntb(c), spu_cntb_ref(c), c._u32[0]);
+            n += 2;
+        }
+    }
+    printf("test_spu_qby_sse: %s (%ld cases)\n", s_bad ? "FAILED" : "ok", n);
+    return s_bad ? 1 : 0;
+#endif
+}
diff --git a/tools/spu_lifter.py b/tools/spu_lifter.py
index 1f933b5..e31288b 100644
--- a/tools/spu_lifter.py
+++ b/tools/spu_lifter.py
@@ -498,6 +498,70 @@ def compute_link_returns(insns, bounds) -> set:
 # set as find_spu_functions.LV2_RESUMING_STOPS, which decides function extents).
 LV2_RESUMING_STOPS = {0x100, 0x110, 0x111}
 
+_GPR_RE = re.compile(r"ctx->gpr\[(\d+)\]")
+# A line is "pure" when ctx appears in it only as a register or as the LS
+# accessors' first argument: those touch neither ctx->gpr nor anything that
+# reads it (the LS watch diagnostic reads r0, and sees it as of the last
+# flush). Anything else -- a channel op, a call, ctx->pc, a stop -- may read
+# or write the register file.
+_PURE_CTX_RE = re.compile(r"ctx->gpr\[\d+\]|spu_ls_(?:read|write)128\(ctx,")
+_ASSIGN_RE = re.compile(r"ctx->gpr\[(\d+)\]\s*=(?!=)")
+# `{ ctx->pc = ...; g_spu_trampoline_fn = ...; return; }`, alone or behind an if
+_EXIT_BLOCK_RE = re.compile(r"^(if \(.*\) )?\{ (ctx->pc = [^;]+; g_spu_trampoline_fn = [^;]+; return;) \}$")
+
+
+def promote_registers(body_lines: list) -> list:
+    """Keep the SPU registers of one lifted function in C locals.
+
+    Lifted code reads and writes ctx->gpr[n] for every instruction, and the LS
+    stores go through byte pointers, which may alias the register file: the
+    compiler has to keep all of it in memory, a load and a store per operand.
+    Here each register the function uses lives in a local `_gN`, loaded on
+    entry. The registers it writes go back to ctx->gpr on every way out -- a
+    tail transfer, a return, a call or anything else that is handed ctx --
+    and after such a call all of them are read back. Exits taken from inside
+    an `if` flush only on the taken path, so a loop's conditional exit costs
+    nothing while the loop runs.
+    """
+    def pure(line):
+        return "ctx" not in _PURE_CTX_RE.sub("", line) and "return" not in line
+
+    used, written = set(), set()
+    for b in body_lines:
+        if b.endswith(":"):
+            continue
+        used.update(int(n) for n in _GPR_RE.findall(b))
+        written.update(int(n) for n in _ASSIGN_RE.findall(b))
+    if not used:
+        return body_lines
+    loc = lambda s: _GPR_RE.sub(lambda m: f"_g{m.group(1)}", s)
+    flush = " ".join(f"ctx->gpr[{n}] = _g{n};" for n in sorted(written))
+    reload_all = " ".join(f"_g{n} = ctx->gpr[{n}];" for n in sorted(used))
+    out = [f"u128 {', '.join(f'_g{n} = ctx->gpr[{n}]' for n in sorted(used))};"]
+    for b in body_lines:
+        b = b.strip()
+        if b.endswith(":"):
+            out.append(b)
+            continue
+        if pure(b):
+            out.append(loc(b))
+            continue
+        m = _EXIT_BLOCK_RE.match(b)
+        if m:   # the exit reads no register (ctx->pc is a constant): flush inside
+            cond = loc(m.group(1) or "")
+            out.append(f"{cond}{{ {flush} {m.group(2)} }}")
+            continue
+        if b.strip() in ("SPU_RET(ctx);",) or b.startswith("SPU_RET_REG(ctx,"):
+            out.append(f"{{ {flush} {b} }}")
+            continue
+        # Anything else runs on ctx->gpr itself, between a flush and a reload.
+        # A line that only returns needs no reload, but it does no harm; one
+        # that jumps to a label inside the function reloads before the jump.
+        b = re.sub(r"\bgoto (loc_[0-9A-F]+);", lambda m: f"{{ {reload_all} goto {m.group(1)}; }}", b)
+        out.append(f"{{ {flush} {b} {reload_all} }}")
+    return out
+
+
 class SPULifter:
     def __init__(self, trace: bool = False, prefix: str = ""):
         self.functions: list[LiftedFunction] = []
@@ -536,6 +600,8 @@ class SPULifter:
         # stqa, bra, ila) stay as they are: code that runs from anywhere
         # cannot use them for its own addresses either.
         self.pic = False
+        # --promote-regs / SPU_LIFT_PROMOTE=1: registers in C locals (promote_registers).
+        self.promote = False
 
     def _pa(self, x: int) -> str:
         """A PC-derived LS address, as a C expression."""
@@ -1096,7 +1162,8 @@ class SPULifter:
             lines.append(f"void {weak}{f.name}(spu_context* ctx) {{")
             if self.pic:
                 lines.append("    const uint32_t _pic = ctx->pic_delta; (void)_pic;")
-            for b in f.body_lines:
+            body = promote_registers(f.body_lines) if self.promote else f.body_lines
+            for b in body:
                 lines.append(b if b.endswith(":") else f"    {b}")
