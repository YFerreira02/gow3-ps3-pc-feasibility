             snprintf(decl, sizeof(decl), "%s rsx_tex%u : register(t%u);\n",
-                     ((tex_cube_mask >> u) & 1u) ? "TextureCube" : "Texture2D  ", u, u);
+                     ((tex_cube_mask >> u) & 1u) ? "TextureCube" :
+                     ((vol_mask >> u) & 1u) ? "Texture3D  " : "Texture2D  ", u, u);
             out_puts(&p, decl);
         }
     }
