@@ -1930,10 +1930,31 @@ static DWORD WINAPI spurs_pm_worker(LPVOID p)
             SleepConditionVariableSRW(&si->wake, &si->lock, INFINITE, 0);
         if (si->stopping && !slot->busy) break;
         ReleaseSRWLockExclusive(&si->lock);
+        /* SPURS_WID_TIMELOG=<us>: one line per policy-module run that lasted
+         * at least <us> (1 = all), with its start, length, workload and SPU,
+         * so tools/frame_timeline.py can lay the workloads out in a frame. */
+        extern unsigned long long ps3_qpc_us(void);
+        static long s_wtl = -1;
+        if (s_wtl < 0) { const char* e = getenv("SPURS_WID_TIMELOG"); s_wtl = e ? atol(e) : 0; }
+        const unsigned long long wt0 = s_wtl ? ps3_qpc_us() : 0;
+        FILETIME wc, we, wk0, wu0, wk1, wu1;
+        if (s_wtl) GetThreadTimes(GetCurrentThread(), &wc, &we, &wk0, &wu0);
         spu_run_policy_module(slot->fn, slot->image_id, slot->pm, slot->pm_size,
                               slot->data, slot->wid, slot->ea, slot->spu_num);
         extern SPU_THREAD_LOCAL volatile unsigned g_spurs_pm_polls;
         unsigned polls = g_spurs_pm_polls;
+        if (s_wtl) {
+            const unsigned long long wd = ps3_qpc_us() - wt0;
+            if (wd >= (unsigned long long)s_wtl) {
+                /* cpu: what the thread used of it (user + kernel), in us */
+                GetThreadTimes(GetCurrentThread(), &wc, &we, &wk1, &wu1);
+                #define FT64(f) (((unsigned long long)(f).dwHighDateTime << 32) | (f).dwLowDateTime)
+                fprintf(stderr, "[wid-time] t=%lluus d=%lluus wid=%u spu=%u polls=%u cpu=%llu+%lluus\n",
+                        wt0, wd, slot->wid, slot->spu_num, polls,
+                        (FT64(wu1) - FT64(wu0)) / 10, (FT64(wk1) - FT64(wk0)) / 10);
+                #undef FT64
+            }
+        }
         AcquireSRWLockExclusive(&si->lock);
         u32 wid = slot->wid;
         if (si->active[wid]) si->active[wid]--;
