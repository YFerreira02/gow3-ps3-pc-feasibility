 libs/spurs/cellSpurs.c                  |  27 +++++-
 runtime/spu/spu_channels.c              |  15 ++++
 runtime/spu/spu_helpers.h               | 113 ++++++++++++++++++++----
 runtime/spu/tests/test_spu_float_neon.c |  21 ++++-
 templates/project/CMakeLists.txt        |  12 ++-
 6 files changed, 176 insertions(+), 21 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 97f43d3..bee4c8a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -336,6 +336,15 @@ if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
     if(PS3RECOMP_HAS_MSSE41)
         target_compile_options(ps3recomp_runtime PRIVATE -msse4.1)
     endif()
+    # The SPU float fast path (spu_helpers.h) runs with MXCSR rounding toward
+    # zero; -frounding-math keeps the compiler from folding float ops on
+    # constants under round-to-nearest (C only: the runtime's C++ third-party
+    # tables need their double->float initialisers folded). clang-cl takes it as /clang:.
+    if(MSVC)
+        target_compile_options(ps3recomp_runtime PRIVATE $<$<COMPILE_LANGUAGE:C>:/clang:-frounding-math>)
+    else()
+        target_compile_options(ps3recomp_runtime PRIVATE $<$<COMPILE_LANGUAGE:C>:-frounding-math>)
+    endif()
 elseif(MSVC)
     # Real cl.exe -- clang-cl reports its id as Clang and is handled above.
     #
diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 2b370af..2442182 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -486,8 +486,33 @@ static void wkl_signal_clear(u32 ea, u32 wid)
     u32 off = wkl_signal_off(wid);
     ef_w16(ea + off, (u16)(vm_read16(ea + off) & ~(0x8000u >> (wid & 15))));
 }
+/* SPURS_MAXCONT=<wid>=<n>[,<wid>=<n>...]: let more SPUs run a workload at
+ * once than the title asked for. A Wws job list keeps per-SPU progress lanes
+ * (six), so its manager is built to share a list between SPUs; a title that
+ * gave a heavy list one SPU (God of War: Ascension's main-menu list, wid 3)
+ * fitted a real SPU's speed, not a recompiled one's. 0 or unset: the title's. */
+static u32 wkl_maxcont_override(u32 wid)
+{
+    static int s_init; static u8 s_over[32];
+    if (!s_init) {
+        const char* e = getenv("SPURS_MAXCONT");
+        while (e && *e) {
+            char* end; unsigned long w = strtoul(e, &end, 10);
+            if (*end != '=') break;
+            unsigned long n = strtoul(end + 1, &end, 10);
+            if (w < 32 && n < 256) s_over[w] = (u8)n;
+            e = (*end == ',') ? end + 1 : NULL;
+        }
+        s_init = 1;
+    }
+    return wid < 32 ? s_over[wid] : 0;
+}
 static u32 wkl_maxcont(u32 ea, u32 wid)
-{ return wid < 16 ? vm_read8(ea + SPURS_WKL_MAXCONT + wid) : s_workloads[wid].maxContention; }
+{
+    const u32 over = wkl_maxcont_override(wid);
+    if (over) return over;
+    return wid < 16 ? vm_read8(ea + SPURS_WKL_MAXCONT + wid) : s_workloads[wid].maxContention;
+}
 static void wkl_curcont_set(u32 ea, u32 wid, u8 v)
 { if (wid < 16) vm_base[ea + SPURS_WKL_CURCONT + wid] = v; }
 
diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index cf3a910..a8fc0dd 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -240,6 +240,18 @@ int spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx)
      * executes at a time. No-op when unarmed. The thread-local halt env above
      * makes a token pause/resume mid-run safe. */
     yz_lockstep_register(ctx);
+    /* The SPU's float mode for the run (spu_helpers.h, spu__xs_fa): single
+     * precision truncates and flushes denormals, which MXCSR's RZ/FTZ/DAZ do
+     * in one instruction; the helpers that need round-to-nearest switch back
+     * for their own span. SPU_FAST_FP=0 keeps the standard mode (every float
+     * op on the exact path, as before). longjmp restores the mode setjmp saw,
+     * so a halt lands in this mode and the restore below still runs. */
+#if defined(__x86_64__) || defined(_M_X64)
+    static int s_fast_fp = -1;
+    if (s_fast_fp < 0) { const char* e = getenv("SPU_FAST_FP"); s_fast_fp = !(e && e[0] == '0'); }
+    const unsigned csr_saved = _mm_getcsr();
+    if (s_fast_fp) _mm_setcsr(csr_saved | SPU_MXCSR_SPU_BITS);
+#endif
     switch (setjmp(s_spu_halt_env)) {
     case 1:
         halted = 1;
@@ -269,6 +281,9 @@ int spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx)
               fflush(stderr); } }
         SPU_DRAIN(ctx);
     }
+#if defined(__x86_64__) || defined(_M_X64)
+    _mm_setcsr(csr_saved);
+#endif
     yz_lockstep_unregister(ctx);   /* leave the ring; hand the token onward */
     s_spu_halt_armed = outer_armed;
     if (outer_armed) memcpy(s_spu_halt_env, outer_env, sizeof(jmp_buf));
diff --git a/runtime/spu/spu_helpers.h b/runtime/spu/spu_helpers.h
index f3bd021..5591832 100644
--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -596,6 +596,20 @@ static inline uint32_t spu__fma_lane(uint32_t x, uint32_t y, uint32_t z, uint32_
     if (!nz) return spu__sf_pack(sp, p, ex + ey);
     return spu__sf_sum(sp, p, ex + ey, sz, mz, ez);
 }
+/* The SPU float mode in MXCSR (see spu__xs_fa below) and a scope that puts the
+ * host's standard mode back, for code that needs round-to-nearest with
+ * denormals: the exact single-precision paths and SPU double precision. */
+#if defined(__x86_64__) || defined(_M_X64)
+#include <xmmintrin.h>
+#define SPU_MXCSR_SPU_BITS 0xE040u            /* RZ rounding (0x6000) | FTZ (0x8000) | DAZ (0x0040) */
+#define SPU_FP_STD_BEGIN const unsigned spu__csr_saved = _mm_getcsr(); \
+    if (spu__csr_saved & SPU_MXCSR_SPU_BITS) _mm_setcsr(spu__csr_saved & ~SPU_MXCSR_SPU_BITS)
+#define SPU_FP_STD_END if (spu__csr_saved & SPU_MXCSR_SPU_BITS) _mm_setcsr(spu__csr_saved)
+#else
+#define SPU_FP_STD_BEGIN (void)0
+#define SPU_FP_STD_END (void)0
+#endif
+
 /* Fast path, exact by construction, for the common case where every operand is an ordinary
  * normal single (biased exponent 1..254): the value is formed in double precision and truncated
  * by masking the 29 low significand bits, which is truncation toward zero of the magnitude.
@@ -913,21 +927,27 @@ SPU__XS_INLINE int spu__xs_all4(__m128i m) { return _mm_movemask_ps(_mm_castsi12
 #define SPU__XS_LANES(v, m) uint32_t m[4]; _mm_storeu_si128((__m128i*)(void*)m, v)
 SPU__XS_SLOW __m128i spu__xs_fa_fix(__m128i r, __m128i ok, __m128i a, __m128i b, uint32_t negb) {
     SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y);
+    SPU_FP_STD_BEGIN;
     for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fa_any(x[i], y[i] ^ negb);
+    SPU_FP_STD_END;
     return _mm_loadu_si128((const __m128i*)(const void*)o);
 }
 SPU__XS_SLOW __m128i spu__xs_fm_fix(__m128i r, __m128i ok, __m128i a, __m128i b) {
     SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y);
+    SPU_FP_STD_BEGIN;
     for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fm_any(x[i], y[i]);
+    SPU_FP_STD_END;
     return _mm_loadu_si128((const __m128i*)(const void*)o);
 }
 SPU__XS_SLOW __m128i spu__xs_fma_fix(__m128i r, __m128i ok, __m128i a, __m128i b, __m128i c,
                                      uint32_t negp, uint32_t negc) {
     SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y); SPU__XS_LANES(c, z);
+    SPU_FP_STD_BEGIN;
     for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fma_any(x[i], y[i], z[i], negp, negc);
+    SPU_FP_STD_END;
     return _mm_loadu_si128((const __m128i*)(const void*)o);
 }
