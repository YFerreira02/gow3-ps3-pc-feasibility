+/* Standard mode: TwoSum and the boundary test. SPU mode: the plain double sum.
+ * Any other mode (rounding bits set some other way) goes the standard way. */
+SPU__XS_INLINE u128 spu__xs_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const unsigned csr = _mm_getcsr() & SPU_MXCSR_SPU_BITS;
+    if (csr == SPU_MXCSR_SPU_BITS) return spu__xs_fma_exact2(a, b, c, negp, negc, 1);
+    if (!csr) return spu__xs_fma_exact2(a, b, c, negp, negc, 0);
+    SPU_FP_STD_BEGIN; const u128 r = spu__xs_fma_exact2(a, b, c, negp, negc, 0); SPU_FP_STD_END; return r;
+}
 SPU__XS_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__xs_fma(a, b, c, 0, 0); }            /* a*b + c */
 SPU__XS_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__xs_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
 SPU__XS_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__xs_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
